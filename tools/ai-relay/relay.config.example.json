{
  "channels": {
    "claude": {
      "mode": "cli",
      "command": "claude",
      "args": ["-p", "--output-format", "text"],
      "timeoutMinutes": 20
    },
    "codex": {
      "mode": "cli",
      "command": "codex",
      "args": ["exec", "--skip-git-repo-check", "--sandbox", "read-only", "--output-last-message", "{output}", "-"],
      "timeoutMinutes": 20
    },
    "gemini": {
      "mode": "manual"
    }
  }
}
